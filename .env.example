# ChestVision AI environment configuration example
# Copy to .env and update paths for your machine

CHESTVISION_DATA_ROOT=data
CHESTVISION_BATCH_SIZE=32
CHESTVISION_EPOCHS=50
CHESTVISION_LR=0.0001
CHESTVISION_THRESHOLD=0.5
CHESTVISION_DEVICE=auto
CHESTVISION_NUM_WORKERS=4
CHESTVISION_HISTORY_DB=logs/prediction_history.json
